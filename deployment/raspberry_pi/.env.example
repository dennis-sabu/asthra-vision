# ASTHRA Vision Production Environment Configuration

# Model Settings
# Path to the production NCNN model directory
ASTHRA_MODEL_PATH=models/production/yolo26n_ncnn_model
# Detection confidence threshold (0.0 to 1.0)
ASTHRA_CONFIDENCE_THRESHOLD=0.5

# Camera Settings
# USB index (e.g., 0) or HTTP stream URL (e.g., http://192.168.1.100/stream)
ASTHRA_CAMERA_SOURCE=0
ASTHRA_FRAME_WIDTH=640
ASTHRA_FRAME_HEIGHT=480

# Tracking & Control Settings
ASTHRA_TARGET_LOCK_TIMEOUT=2.0
ASTHRA_SMOOTHING_FACTOR=0.2
ASTHRA_MAX_YAW_ANGLE=40.0
